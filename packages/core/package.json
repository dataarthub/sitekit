    "static-site",
    "cms",
    "content-management",
    "snapshot",
    "alneas"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-core.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "bun run --cwd ../.. release:check",
    "test": "vitest run --root ../.."
  },
  "peerDependenciesMeta": {
    "@alneas/appkit-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
